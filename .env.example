# ┌────────────────────────────────────────────────┐
# │  Discord Data Manager Bot — Environment Vars   │
# └────────────────────────────────────────────────┘

# ── Discord ──────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here

# Role IDs (right-click role in Discord → Copy ID)
DATA_MANAGER_ROLE_ID=000000000000000000
STAFF_ROLE_ID=000000000000000000

# Optional: restrict scannable channels (comma-separated IDs).
# Leave blank to allow any channel the bot can read.
ALLOWED_CHANNEL_IDS=

# Optional: set a guild ID to sync commands instantly during dev.
# Remove or leave blank for global sync (takes up to 1 hour).
DEV_GUILD_ID=

# ── Google Sheets ────────────────────────────────
GOOGLE_SPREADSHEET_ID=1gZRy4HY6kCOd4WkCgK9C3e4s8V4vC-K4R4ywvRr_0C8

# Option A: path to the service-account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Option B: paste the entire JSON string (useful for cloud hosts)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Player tabs to search (comma-separated, must match spreadsheet exactly).
# Default covers all player tabs — only change if you add/remove tabs.
PLAYER_SHEETS=[D] ROOK,[D] BASTION,[C] ANCILLARY,[S] PEACEKEEPER,[U] MEDICAL,[U] RESEARCH,[U] CANNONEER,[U] VALKYRIE,COMMAND,J. COMMAND,QUARTERMASTER,DEVICE WIELDERS

# ── Scan ─────────────────────────────────────────
SCAN_HOURS=48

# ── Database ─────────────────────────────────────
# SQLite (default — fine for small deployments):
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
